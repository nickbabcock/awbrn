{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nickbabcock/awbrn/master/spec/schema/common.schema.json",
  "title": "AWVM common values",
  "$defs": {
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "$ref": "#/$defs/ruleset-id" },
        "revision": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "position": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
    "unit-id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "player-id": { "$ref": "#/$defs/id" },
    "team-id": { "$ref": "#/$defs/id" },
    "commander-id": { "$ref": "#/$defs/id" },
    "unit-kind-id": { "$ref": "#/$defs/id" },
    "terrain-id": { "$ref": "#/$defs/id" },
    "teleporter-id": { "$ref": "#/$defs/id" },
    "trait-id": { "$ref": "#/$defs/id" },
    "reason-id": { "$ref": "#/$defs/id" },
    "ruleset-id": { "const": "awbw" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nickbabcock/awbrn/master/spec/schema/observed-event.schema.json",
  "title": "AWVM observed event",
  "oneOf": [
    { "$ref": "#/$defs/unit-moved" },
    { "$ref": "#/$defs/unit-appeared" },
    { "$ref": "#/$defs/unit-disappeared" },
    { "$ref": "#/$defs/movement-stopped" },
    { "$ref": "#/$defs/unit-changed" },
    { "$ref": "#/$defs/unit-removed" },
    { "$ref": "#/$defs/tile-changed" },
    { "$ref": "#/$defs/player-changed" },
    { "$ref": "#/$defs/area-strike-resolved" },
    { "$ref": "#/$defs/public-event" }
  ],
  "$defs": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "unit-ref": { "$ref": "observation.schema.json#/$defs/unit-ref" },
    "position": { "$ref": "common.schema.json#/$defs/position" },
    "unit-moved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "unit", "from", "to", "path"],
      "properties": {
        "type": { "const": "unit-moved" },
        "unit": { "$ref": "#/$defs/unit-ref" },
        "from": { "$ref": "#/$defs/position" },
        "to": { "$ref": "#/$defs/position" },
        "path": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/position" } }
      }
    },
    "unit-appeared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "unit", "position"],
      "properties": {
        "type": { "const": "unit-appeared" },
        "unit": { "$ref": "observation.schema.json#/$defs/unit" },
        "position": { "$ref": "#/$defs/position" }
      }
    },
    "unit-disappeared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "unit", "position"],
      "properties": {
        "type": { "const": "unit-disappeared" },
        "unit": { "$ref": "#/$defs/unit-ref" },
        "position": { "$ref": "#/$defs/position" }
      }
    },
    "movement-stopped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "unit"],
      "properties": {
        "type": { "const": "movement-stopped" },
        "unit": { "$ref": "#/$defs/unit-ref" }
      }
    },
    "unit-changed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "unit", "state", "reason"],
      "properties": {
        "type": { "const": "unit-changed" },
        "unit": { "$ref": "#/$defs/unit-ref" },
        "state": { "$ref": "observation.schema.json#/$defs/unit" },
        "reason": { "$ref": "common.schema.json#/$defs/reason-id" }
      }
    },
    "unit-removed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "unit", "reason"],
      "properties": {
        "type": { "const": "unit-removed" },
        "unit": { "$ref": "#/$defs/unit-ref" },
        "reason": { "$ref": "common.schema.json#/$defs/reason-id" }
      }
    },
    "tile-changed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "position", "tile", "reason"],
      "properties": {
        "type": { "const": "tile-changed" },
        "position": { "$ref": "#/$defs/position" },
        "tile": { "$ref": "observation.schema.json#/$defs/tile" },
        "reason": { "$ref": "common.schema.json#/$defs/reason-id" }
      }
    },
    "player-changed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "player", "state", "reason"],
      "properties": {
        "type": { "const": "player-changed" },
        "player": { "$ref": "common.schema.json#/$defs/player-id" },
        "state": { "$ref": "observation.schema.json#/$defs/player" },
        "reason": { "$ref": "common.schema.json#/$defs/reason-id" }
      }
    },
    "area-strike-resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "strike", "policy", "center", "radius", "damage"],
      "properties": {
        "type": { "const": "area-strike-resolved" },
        "strike": { "type": "integer", "minimum": 0 },
        "policy": { "enum": ["infantry-hp", "unit-value", "unit-hp"] },
        "center": { "$ref": "#/$defs/position" },
        "radius": { "type": "integer", "minimum": 0 },
        "damage": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "public-event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind"],
      "properties": {
        "type": { "const": "public-event" },
        "kind": {
          "enum": [
            "phase-changed",
            "turn-selected",
            "day-advanced",
            "weather-changed",
            "power-activated",
            "power-ended",
            "commander-swapped",
            "draw-offer-changed",
            "player-status-changed",
            "team-eliminated",
            "match-completed"
          ]
        }
      }
    }
  }
}

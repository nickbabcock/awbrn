{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nickbabcock/awbrn/master/spec/schema/state.schema.json",
  "title": "AWVM authoritative match state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ruleset",
    "settings",
    "board",
    "teams",
    "players",
    "turn",
    "weather",
    "units",
    "match"
  ],
  "properties": {
    "ruleset": { "$ref": "common.schema.json#/$defs/ruleset" },
    "settings": { "$ref": "settings.schema.json" },
    "board": { "$ref": "#/$defs/board" },
    "teams": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/team" } },
    "players": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/player" } },
    "turn": { "$ref": "#/$defs/turn" },
    "weather": { "$ref": "#/$defs/weather" },
    "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } },
    "next_unit_id": { "$ref": "common.schema.json#/$defs/unit-id" },
    "match": { "$ref": "#/$defs/match" }
  },
  "$defs": {
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "tiles"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "tiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tile" } }
        }
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terrain"],
      "properties": {
        "terrain": { "$ref": "common.schema.json#/$defs/terrain-id" },
        "owner": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/player-id" }, { "type": "null" }]
        },
        "capture_points": { "type": "integer", "minimum": 1, "maximum": 20 },
        "silo": { "enum": ["ready", "spent"] },
        "destructible_hp": { "type": "integer", "minimum": 1 },
        "teleporter": { "$ref": "common.schema.json#/$defs/teleporter-id" },
        "trait_state": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/trait-id" }
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/team-id" },
        "status": { "enum": ["active", "eliminated"] }
      }
    },
    "commander": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "active", "power_charge", "power_uses"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/commander-id" },
        "active": { "type": "boolean" },
        "power_charge": { "type": "integer", "minimum": 0 },
        "power_uses": { "type": "integer", "minimum": 0 }
      }
    },
    "power-state": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "commander_slot"],
          "properties": {
            "type": { "enum": ["cop", "scop"] },
            "commander_slot": { "type": "integer", "minimum": 0, "maximum": 1 }
          }
        }
      ]
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "team", "funds", "status", "commanders", "power_state"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/player-id" },
        "team": { "$ref": "common.schema.json#/$defs/team-id" },
        "funds": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["active", "resigned", "timed-out", "eliminated"] },
        "commanders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/commander" }
        },
        "power_state": { "$ref": "#/$defs/power-state" }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "active_player", "phase", "order", "position"],
      "properties": {
        "day": { "type": "integer", "minimum": 1 },
        "active_player": { "$ref": "common.schema.json#/$defs/player-id" },
        "phase": { "enum": ["turn-start", "unit-action", "turn-end", "finished"] },
        "order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/player-id" }
        },
        "position": { "type": "integer", "minimum": 0 }
      }
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "remaining_turns"],
      "properties": {
        "kind": { "enum": ["clear", "rain", "snow"] },
        "remaining_turns": { "type": "integer", "minimum": 0 }
      }
    },
    "location": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "position"],
          "properties": {
            "type": { "const": "board" },
            "position": { "$ref": "common.schema.json#/$defs/position" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "transport", "slot"],
          "properties": {
            "type": { "const": "cargo" },
            "transport": { "$ref": "common.schema.json#/$defs/unit-id" },
            "slot": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "owner",
        "hp",
        "fuel",
        "ammo",
        "action",
        "concealment",
        "location"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/unit-id" },
        "kind": { "$ref": "common.schema.json#/$defs/unit-kind-id" },
        "owner": { "$ref": "common.schema.json#/$defs/player-id" },
        "hp": { "type": "integer", "minimum": 1, "maximum": 100 },
        "fuel": { "type": "integer", "minimum": 0 },
        "ammo": { "type": "integer", "minimum": 0 },
        "action": { "enum": ["ready", "moved", "spent", "immobilized"] },
        "concealment": { "enum": ["exposed", "hidden"] },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "victory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "winners", "reason"],
      "properties": {
        "type": { "const": "victory" },
        "winners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/team-id" }
        },
        "reason": {
          "enum": [
            "rout",
            "hq-capture",
            "lab-capture",
            "capture-limit",
            "day-limit",
            "resignation",
            "timeout"
          ]
        }
      }
    },
    "draw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "teams", "reason"],
      "properties": {
        "type": { "const": "draw" },
        "teams": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/team-id" }
        },
        "reason": { "enum": ["day-limit", "agreement"] }
      }
    },
    "cancelled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reason"],
      "properties": {
        "type": { "const": "cancelled" },
        "reason": { "$ref": "common.schema.json#/$defs/reason-id" }
      }
    },
    "match": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "draw_offers"],
          "properties": {
            "status": { "const": "active" },
            "draw_offers": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "common.schema.json#/$defs/player-id" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "outcome"],
          "properties": {
            "status": { "const": "finished" },
            "outcome": {
              "oneOf": [
                { "$ref": "#/$defs/victory" },
                { "$ref": "#/$defs/draw" },
                { "$ref": "#/$defs/cancelled" }
              ]
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nickbabcock/awbrn/master/spec/schema/random.schema.json",
  "title": "AWVM explicit random token",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["combat-good-luck", "combat-bad-luck"] },
        "value": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "weather-selection" },
        "value": { "enum": ["clear", "rain", "snow"] }
      }
    }
  ]
}

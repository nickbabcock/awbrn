{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nickbabcock/awbrn/master/spec/schema/commander-powers.schema.json",
  "title": "AWVM commander power activation profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "feature", "base_star_charge", "use_cost_scaling", "commanders"],
  "properties": {
    "$schema": { "type": "string" },
    "status": { "enum": ["partial", "complete"] },
    "feature": { "$ref": "common.schema.json#/$defs/id" },
    "base_star_charge": { "type": "integer", "minimum": 1 },
    "use_cost_scaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "maximum_uses"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 1 },
        "maximum_uses": { "type": "integer", "minimum": 0 }
      }
    },
    "commanders": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/commander" }
    }
  },
  "$defs": {
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stars", "instant_effects"],
      "properties": {
        "stars": { "type": "integer", "minimum": 1 },
        "instant_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/instant-effect" }
        },
        "strike_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/strike-effect" }
        }
      }
    },
    "strike-effect": {
      "oneOf": [{ "$ref": "#/$defs/gain-funds-from-visual-hp-damage" }]
    },
    "gain-funds-from-visual-hp-damage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "target", "numerator", "denominator", "unit_value"],
      "properties": {
        "operator": { "const": "gain-funds-from-visual-hp-damage" },
        "target": { "const": "enemy-unit" },
        "numerator": { "type": "integer", "minimum": 1 },
        "denominator": { "type": "integer", "minimum": 1 },
        "unit_value": { "const": "effective-build-cost" }
      }
    },
    "instant-effect": {
      "oneOf": [
        { "$ref": "#/$defs/heal-visual-hp" },
        { "$ref": "#/$defs/heal-exact-hp" },
        { "$ref": "#/$defs/damage-exact-hp" },
        { "$ref": "#/$defs/set-weather" },
        { "$ref": "#/$defs/drain-current-fuel-ratio" },
        { "$ref": "#/$defs/fire-area-strikes" },
        { "$ref": "#/$defs/reduce-power-charge-by-funds-ratio" },
        { "$ref": "#/$defs/refresh-unit-action" },
        { "$ref": "#/$defs/resupply-units" },
        { "$ref": "#/$defs/spawn-units-on-owned-properties" },
        { "$ref": "#/$defs/fire-targeted-area-strike" },
        { "$ref": "#/$defs/fire-immobilizing-area-strike" },
        { "$ref": "#/$defs/multiply-funds-ratio" }
      ]
    },
    "heal-visual-hp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "target", "amount"],
      "properties": {
        "operator": { "const": "heal-visual-hp" },
        "target": { "const": "owned-units" },
        "amount": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "heal-exact-hp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "target", "amount"],
      "properties": {
        "operator": { "const": "heal-exact-hp" },
        "target": { "const": "owned-units" },
        "amount": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "damage-exact-hp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "target", "amount", "minimum_hp"],
      "properties": {
        "operator": { "const": "damage-exact-hp" },
        "target": { "enum": ["enemy-units", "enemy-units-on-properties"] },
        "amount": { "type": "integer", "minimum": 1, "maximum": 99 },
        "minimum_hp": { "const": 1 }
      }
    },
    "set-weather": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "kind", "duration"],
      "properties": {
        "operator": { "const": "set-weather" },
        "kind": { "enum": ["clear", "rain", "snow"] },
        "duration": { "const": "until-owner-next-turn" }
      }
    },
    "drain-current-fuel-ratio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "target", "numerator", "denominator"],
      "properties": {
        "operator": { "const": "drain-current-fuel-ratio" },
        "target": { "const": "enemy-units" },
        "numerator": { "type": "integer", "minimum": 1 },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    },
    "fire-area-strikes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "target",
        "radius",
        "damage",
        "minimum_hp",
        "selection_policies",
        "friendly_contribution"
      ],
      "properties": {
        "operator": { "const": "fire-area-strikes" },
        "target": { "const": "all-board-units" },
        "radius": { "type": "integer", "minimum": 0 },
        "damage": { "type": "integer", "minimum": 1, "maximum": 99 },
        "minimum_hp": { "const": 1 },
        "selection_policies": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["infantry-hp", "unit-value", "unit-hp"] }
        },
        "friendly_contribution": { "const": "subtract" }
      }
    },
    "reduce-power-charge-by-funds-ratio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "target", "funds_per_full_bar"],
      "properties": {
        "operator": { "const": "reduce-power-charge-by-funds-ratio" },
        "target": { "const": "enemy-commander-slots" },
        "funds_per_full_bar": { "type": "integer", "minimum": 1 }
      }
    },
    "refresh-unit-action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "target", "exclude_unit_kinds"],
      "properties": {
        "operator": { "const": "refresh-unit-action" },
        "target": { "const": "owned-units" },
        "exclude_unit_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        }
      }
    },
    "resupply-units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "target"],
      "properties": {
        "operator": { "const": "resupply-units" },
        "target": { "const": "owned-units" }
      }
    },
    "spawn-units-on-owned-properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "target",
        "property_kinds",
        "unit_kind",
        "hp",
        "resources",
        "action",
        "concealment",
        "occupied_tiles",
        "order",
        "unit_limit"
      ],
      "properties": {
        "operator": { "const": "spawn-units-on-owned-properties" },
        "target": { "const": "owned-properties" },
        "property_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        },
        "unit_kind": { "$ref": "common.schema.json#/$defs/id" },
        "hp": { "type": "integer", "minimum": 1, "maximum": 100 },
        "resources": { "const": "unit-maxima" },
        "action": { "const": "ready" },
        "concealment": { "const": "exposed" },
        "occupied_tiles": { "const": "skip" },
        "order": { "const": "y-then-x" },
        "unit_limit": { "const": "settings" }
      }
    },
    "fire-targeted-area-strike": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "target",
        "radius",
        "damage",
        "minimum_hp",
        "selection_policy",
        "friendly_contribution",
        "unit_value"
      ],
      "properties": {
        "operator": { "const": "fire-targeted-area-strike" },
        "target": { "const": "enemy-unit-centers" },
        "radius": { "type": "integer", "minimum": 0 },
        "damage": { "type": "integer", "minimum": 1, "maximum": 99 },
        "minimum_hp": { "const": 1 },
        "selection_policy": { "const": "unit-value" },
        "friendly_contribution": { "const": "subtract" },
        "unit_value": { "const": "base-build-cost" }
      }
    },
    "fire-immobilizing-area-strike": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "target",
        "radius",
        "damage",
        "minimum_hp",
        "selection_policy",
        "friendly_contribution",
        "unit_value",
        "duration"
      ],
      "properties": {
        "operator": { "const": "fire-immobilizing-area-strike" },
        "target": { "const": "enemy-units" },
        "radius": { "type": "integer", "minimum": 0 },
        "damage": { "type": "integer", "minimum": 1, "maximum": 99 },
        "minimum_hp": { "const": 1 },
        "selection_policy": { "const": "unit-value" },
        "friendly_contribution": { "const": "subtract" },
        "unit_value": { "const": "base-build-cost" },
        "duration": { "const": "through-target-next-turn" }
      }
    },
    "multiply-funds-ratio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "target", "numerator", "denominator"],
      "properties": {
        "operator": { "const": "multiply-funds-ratio" },
        "target": { "const": "activating-player" },
        "numerator": { "type": "integer", "minimum": 1 },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    },
    "commander": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "cop": { "$ref": "#/$defs/power" },
        "scop": { "$ref": "#/$defs/power" }
      }
    }
  }
}

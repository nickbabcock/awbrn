{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awbrn-web",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "vars": {
    "AUTH_URL": "http://localhost:5173",
  },
  "secrets": {
    "required": ["AUTH_SECRET"],
  },
  // The renderer that draws a map screenshot reads the sprite atlases through
  // this binding, so it reads the same files the browser is served.
  "assets": {
    "binding": "ASSETS",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCHES",
        "class_name": "MatchDurableObject",
      },
      {
        "name": "AWBW_GATEWAY",
        "class_name": "AwbwGatewayDurableObject",
      },
      {
        "name": "MATCHMAKERS",
        "class_name": "MatchmakerDurableObject",
      },
    ],
  },
  "exports": {
    "MatchDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "AwbwGatewayDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "MatchmakerDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "ratelimits": [
    {
      "name": "CREATE_MATCH_RATE_LIMITER",
      "namespace_id": "73184201",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "IMPORT_MAP_RATE_LIMITER",
      "namespace_id": "73184202",
      "simple": { "limit": 2, "period": 60 },
    },
    {
      "name": "LOBBY_WRITE_RATE_LIMITER",
      "namespace_id": "73184203",
      "simple": { "limit": 30, "period": 10 },
    },
    {
      "name": "AWBW_ACTOR_RATE_LIMITER",
      "namespace_id": "73184204",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "WS_UPGRADE_RATE_LIMITER",
      "namespace_id": "73184206",
      "simple": { "limit": 10, "period": 10 },
    },
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "awbrn-content",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "awbrn-db",
      "migrations_dir": "drizzle/global",
    },
  ],
}

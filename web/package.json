{
  "name": "awbrn-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "cf-typegen": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:generate-do": "drizzle-kit generate --config drizzle-do.config.ts",
    "db:generate-player": "drizzle-kit generate --config drizzle-player.config.ts",
    "dev": "vite dev",
    "build": "pnpm run theme:build && pnpm run cf-typegen && vite build && tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "theme:build": "pnpm exec astryx theme build src/themes/awbrnTheme.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.5.0",
    "@astryxdesign/theme-neutral": "^0.5.0",
    "@fontsource/bungee": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-query": "5.102.4",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.49",
    "better-auth": "1.7.1",
    "comlink": "4.4.2",
    "drizzle-orm": "0.45.2",
    "pixelarticons": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.5.0",
    "@cloudflare/vite-plugin": "1.54.0",
    "@cloudflare/vitest-plugin": "1.1.0",
    "@stylexjs/unplugin": "0.19.0",
    "@types/node": "catalog:",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "drizzle-kit": "0.31.10",
    "typescript": "catalog:",
    "unplugin": "2.3.11",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  }
}

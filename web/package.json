{
  "name": "awbrn-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "cf-typegen": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:generate-do": "drizzle-kit generate --config drizzle-do.config.ts",
    "db:generate-player": "drizzle-kit generate --config drizzle-player.config.ts",
    "dev": "vite dev",
    "build": "pnpm run theme:build && pnpm run cf-typegen && vite build && tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "theme:build": "pnpm exec astryx theme build src/themes/awbrnTheme.ts && pnpm exec oxfmt src/themes"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@stylexjs/stylex": "0.19.2",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "better-auth": "1.7.23",
    "comlink": "4.4.2",
    "drizzle-orm": "0.45.4",
    "pixelarticons": "2.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/vitest-plugin": "1.8.2",
    "@stylexjs/unplugin": "0.19.2",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:",
    "unplugin": "2.3.11",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
